rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper para verificar el rol en Firestore desde Storage
    function getRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Reglas para Hojas de Vida (Resumes)
    match /resumes/{userId}/{allPaths=**} {
      // Solo el dueño, profesores, empresas y admins pueden leer
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        getRole() == 'teacher' || 
        getRole() == 'company' || 
        getRole() == 'admin'
      );
      // Solo el dueño puede subir/modificar su propia hoja de vida
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla por defecto para otros archivos (como imágenes de proyectos)
    match /{allPaths=**} {
      // Usamos allPaths[0] para verificar el primer segmento de la carpeta
      allow read: if allPaths[0] != 'resumes';
      allow write: if request.auth != null && allPaths[0] != 'resumes';
    }
  }
}