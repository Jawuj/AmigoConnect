rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Obtiene el rol del usuario de su documento en Firestore
    function getRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'guest';
    }
    
    // Obtiene el UID real del usuario (el ID del perfil persistente)
    function getActualUid() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.get('actingAs', request.auth.uid) : request.auth.uid;
    }
    
    // Verifica si la sesión actual es admin (incluye sesiones proxy anónimas)
    function isAdmin() {
      return request.auth != null && getRole() == 'admin';
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        getActualUid() == resource.data.authorId || 
        getRole() == 'teacher' ||
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritesCount', 'favoritedBy', 'views', 'viewedBy']))
      );
      allow delete: if request.auth != null && (
        getActualUid() == resource.data.authorId ||
        getRole() == 'teacher' ||
        isAdmin()
      );
    }

    match /users/{userId} {
      allow read: if true;
      
      // Crear: propio doc (bootstrap/proxy), admin, o el bootstrap inicial de system_admin
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (userId == 'system_admin' && !exists(/databases/$(database)/documents/users/system_admin))
      );
      
      // Actualizar: propio doc o admin
      allow update: if request.auth != null && (
        getActualUid() == userId ||
        isAdmin()
      );
      
      // Eliminar: propio doc (salvo system_admin), admin (salvo system_admin), o cuentas de prueba/proxy
      allow delete: if request.auth != null && (
        userId != 'system_admin' && (
          getActualUid() == userId ||
          isAdmin() ||
          resource.data.isTestAccount == true ||
          resource.data.isSessionProxy == true
        )
      );
    }

    match /whitelist_teachers/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /whitelist_companies/{domain} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /opportunities/{oppId} {
      allow read: if true;
      allow create: if request.auth != null && (getRole() == 'company' || isAdmin());
      allow update: if request.auth != null && (
        (getRole() == 'company' && getActualUid() == resource.data.companyId) || 
        getRole() == 'teacher' || 
        isAdmin()
      );
      allow delete: if request.auth != null && (
        (getRole() == 'company' && getActualUid() == resource.data.companyId) || 
        isAdmin()
      );
    }

    // Notificaciones
    match /notifications/{notifId} {
      allow read: if request.auth != null && (resource.data.to == getActualUid() || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.to == getActualUid() || isAdmin());
      allow delete: if request.auth != null && (resource.data.to == getActualUid() || isAdmin());
    }

    // Auditoría
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}